{
  "name": "sonora-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproductor de música local, privado y self-hosted.",
  "scripts": {
    "dev": "concurrently -k \"nodemon server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "eslint client/src server tests",
    "smoke": "node tests/smoke.mjs",
    "test:sources": "node tests/library-sources.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "meyda": "^5.6.3",
    "multer": "^2.0.2",
    "music-metadata": "^11.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
